# ---------------------------------------------------------------------------
# Hedera testnet operator
# Accounts MUST be ECDSA (portal.hedera.com), funded at faucet.hedera.com.
# HBAR needs no token association, which is why the spike prices in HBAR.
# ---------------------------------------------------------------------------
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.XXXXXX
HEDERA_OPERATOR_KEY=

# ---------------------------------------------------------------------------
# Facilitator
# "mock" settles locally and needs no credentials — the default, and what CI
# and the e2e harness use. "blocky402" talks to the real facilitator.
# FACILITATOR_FEE_PAYER is the signer advertised by GET /supported; it co-signs
# as fee payer and submits the transfer, so nothing settles without it.
# ---------------------------------------------------------------------------
FACILITATOR_MODE=mock
FACILITATOR_URL=https://api.testnet.blocky402.com
# FACILITATOR_FEE_PAYER=0.0.7162784

# ---------------------------------------------------------------------------
# Provider daemon
# PUBLIC_URL is what the listing advertises and what renters pay against;
# leave it unset for local runs and it falls back to 127.0.0.1:PORT.
# ---------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
PROVIDER_ID=node-a
PROVIDER_UAID=uaid:local:node-a
# PUBLIC_URL=https://node-a.example.com
PAY_TO=0.0.XXXXXX
NETWORK=hedera-testnet

# Listing parameters (SPEC §4). The §4.1 floor is enforced at startup:
# leadSeconds >= max(4, ceil(0.3 * blockSeconds)) and < blockSeconds.
DEFAULT_BLOCK_SECONDS=30
DEFAULT_LEAD_SECONDS=10
PRICE_PER_BLOCK=1500
ASSET=HBAR

GRACE_PERIOD_MS=5000
WATCHDOG_INTERVAL_MS=1000
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ---------------------------------------------------------------------------
# Receipts
# "local" writes to DATA_DIR only. "hcs" and "local+hcs" publish to the shared
# topic and require the topic id and operator keys — the daemon refuses to boot
# without them rather than leave the audit log quietly empty.
# ---------------------------------------------------------------------------
RECEIPT_SINK=local
HCS_RECEIPT_TOPIC_ID=

# ---------------------------------------------------------------------------
# Control plane (registry + job broker). Discovery and placement only.
# ---------------------------------------------------------------------------
CONTROL_PLANE_PORT=8090
CONTROL_PLANE_DB=./data/control-plane.db
# Set on the daemon to register with a control plane; unset runs standalone.
# CONTROL_PLANE_URL=http://127.0.0.1:8090

# ---------------------------------------------------------------------------
# Console (build time)
# ---------------------------------------------------------------------------
VITE_REGISTRY_URL=http://127.0.0.1:8090

# ---------------------------------------------------------------------------
# Phase 6
# ---------------------------------------------------------------------------
HTS_SETTLEMENT_TOKEN_ID=

# ---------------------------------------------------------------------------
# Phase 0 spike only (optional): separate payer/receiver, else operator pays itself
# ---------------------------------------------------------------------------
# PAYER_ID=0.0.XXXXXX
# PAYER_KEY=
# SPIKE_RECEIVER=0.0.XXXXXX
# SPIKE_PORT=4029
