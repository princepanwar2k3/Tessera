PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
DOCKER_SOCKET_PATH=/var/run/docker.sock
CONTROL_PLANE_URL=
FACILITATOR_MODE=mock
# local | hcs | local+hcs
# Anything but "local" requires the three HEDERA/HCS values below, and the
# daemon refuses to boot without them rather than publishing nowhere.
RECEIPT_SINK=local
HCS_RECEIPT_TOPIC_ID=
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
GRACE_PERIOD_MS=5000
WATCHDOG_INTERVAL_MS=1000
DEFAULT_BLOCK_SECONDS=30
DEFAULT_LEAD_SECONDS=10
PROVIDER_ID=node-a
PROVIDER_UAID=uaid:local:node-a
NETWORK=hedera-testnet
PAY_TO=0.0.PROVIDER
