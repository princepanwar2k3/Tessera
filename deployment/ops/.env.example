# Provider daemon — deployed node.
# Copy to /opt/tessera/packages/daemon/.env and fill in.

PORT=8080
HOST=0.0.0.0
DATA_DIR=/var/lib/tessera
DOCKER_SOCKET_PATH=/var/run/docker.sock

# What this node advertises and what renters pay against. MUST be set on a
# deployed node: without it the listing advertises 127.0.0.1 and no renter
# outside this host can reach it.
PUBLIC_URL=https://node-a.example.com

PROVIDER_ID=node-a
PROVIDER_UAID=uaid:local:node-a
NETWORK=hedera-testnet
PAY_TO=0.0.PROVIDER

# Listing parameters (SPEC §4). The §4.1 floor is checked at startup:
# leadSeconds >= max(4, ceil(0.3 * blockSeconds)) and < blockSeconds.
DEFAULT_BLOCK_SECONDS=30
DEFAULT_LEAD_SECONDS=10
PRICE_PER_BLOCK=1500
ASSET=HBAR

# Registry to register and heartbeat with. Empty runs the node standalone.
CONTROL_PLANE_URL=

# mock | blocky402. blocky402 additionally requires FACILITATOR_FEE_PAYER,
# the co-signer advertised by GET /supported; nothing settles without it.
FACILITATOR_MODE=mock
FACILITATOR_URL=https://api.testnet.blocky402.com
# FACILITATOR_FEE_PAYER=0.0.7162784

# local | hcs | local+hcs
# Anything but "local" requires the three HEDERA/HCS values below, and the
# daemon refuses to boot without them rather than publishing nowhere.
RECEIPT_SINK=local
HCS_RECEIPT_TOPIC_ID=
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

GRACE_PERIOD_MS=5000
WATCHDOG_INTERVAL_MS=1000

# Container hardening for renter-supplied images. Leave unset (on) unless this
# host refuses to exec under it — the symptom is every container dying with
# "exec /bin/sh: operation not permitted". Turning it off leaves the read-only
# root filesystem, memory, CPU, PID and network limits in place.
# NO_NEW_PRIVILEGES=false
